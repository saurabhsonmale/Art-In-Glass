# Replace with your actual MongoDB Atlas connection string
# Get this from: MongoDB Atlas -> Connect -> Connect your application -> Driver: Python
# Example: mongodb+srv://username:password@cluster0.abc123.mongodb.net/resin_art_db?retryWrites=true&w=majority
MONGODB_URI=mongodb+srv://username:password@YOUR_CLUSTER_NAME.mongodb.net/resin_art_db?retryWrites=true&w=majority
JWT_SECRET_KEY=your_jwt_secret_key_here_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
PORT=8000
ENVIRONMENT=development