# Copy to backend/.env for local development (never commit .env).
# On Render: set the same keys in Dashboard → Environment.

# REQUIRED
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/resin_art_db?retryWrites=true&w=majority
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# RECOMMENDED
DATABASE_NAME=resin_art_db
ENVIRONMENT=development
PUBLIC_BASE_URL=https://art-in-glass.onrender.com
CORS_ORIGINS=*
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000

# OPTIONAL
# MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000

# MongoDB Atlas → Network Access: add IP Access List entry 0.0.0.0/0
# (allows Render's dynamic outbound IPs to connect)
