# Copy to backend/.env for LOCAL development (never commit .env).
# For LIVE Render: set the same keys in Dashboard → Environment
# using your Atlas mongodb+srv:// URI (see backend/.env.production locally).

# LOCAL example:
MONGODB_URI=mongodb://localhost:27017/resin_art_db
JWT_SECRET_KEY=change_me_to_a_long_random_secret

# LIVE example (Render Dashboard — use Atlas, never localhost):
# MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@CLUSTER.mongodb.net/resin_art_db?retryWrites=true&w=majority

DATABASE_NAME=resin_art_db
ENVIRONMENT=development
PUBLIC_BASE_URL=https://art-in-glass.onrender.com
CORS_ORIGINS=*
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440
PORT=8000

# Atlas → Network Access: allow 0.0.0.0/0 so Render can connect
